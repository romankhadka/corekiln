#!/bin/sh
set -eu

repository_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
build_dir="$repository_dir/.build"
binary="$build_dir/corekiln"

if [ ! -x "$binary" ] ||
  [ "$repository_dir/src/corekiln.c" -nt "$binary" ] ||
  [ "$repository_dir/src/cpu_kiln.c" -nt "$binary" ] ||
  [ "$repository_dir/src/cpu_kiln.h" -nt "$binary" ] ||
  [ "$repository_dir/src/gpu_kiln.m" -nt "$binary" ] ||
  [ "$repository_dir/src/gpu_kiln.h" -nt "$binary" ] ||
  [ "$repository_dir/src/run_report.c" -nt "$binary" ] ||
  [ "$repository_dir/src/run_report.h" -nt "$binary" ] ||
  [ "$repository_dir/src/system_thermal.m" -nt "$binary" ] ||
  [ "$repository_dir/src/system_thermal.h" -nt "$binary" ]; then
  mkdir -p "$build_dir"
  temporary_binary="$binary.$$"
  trap 'rm -f "$temporary_binary"' 0 HUP INT TERM
  xcrun clang -std=c11 -O2 -Wall -Wextra -Werror -pthread \
    -fobjc-arc -fblocks \
    "$repository_dir/src/corekiln.c" \
    "$repository_dir/src/cpu_kiln.c" \
    "$repository_dir/src/gpu_kiln.m" \
    "$repository_dir/src/run_report.c" \
    "$repository_dir/src/system_thermal.m" \
    -framework Foundation \
    -framework Metal \
    -o "$temporary_binary"
  mv "$temporary_binary" "$binary"
  trap - 0 HUP INT TERM
fi

exec "$binary" "$@"
